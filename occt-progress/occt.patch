+  // MaxTolVert -- the largest vertex tolerance on the face, after the
+  // context's replacements -- is read only once an intersection is found.
+  // Computing it up front applied the context to the WHOLE face and walked
+  // all its vertices for every wire checked, which is quadratic in a face's
+  // wires: about 500 s of a 600 s STEP import, on a face with thousands of
+  // holes, almost all of whose wires intersect nothing. It is now computed at
+  // the first intersection of this call, before this call modifies anything,
+  // so it has the value the up-front computation had.
+  Standard_Real MaxTolVert = -1.0; // < 0: not computed yet
+  const auto aComputeMaxTolVert = [&]()
+  {
+    if (MaxTolVert >= 0.0)
+      return;
+    TopoDS_Shape SF = Context()->Apply(face);
+    MaxTolVert = 0.0;
+    for(TopExp_Explorer exp(SF,TopAbs_VERTEX); exp.More(); exp.Next()) {
+      Standard_Real tolV = BRep_Tool::Tolerance(TopoDS::Vertex(exp.Current()));
+      MaxTolVert = Max(MaxTolVert,tolV);
+    }
+    MaxTolVert = Min(MaxTolVert,myMaxTol);
+  };
