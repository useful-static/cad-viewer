diff --git a/src/BRepMesh/BRepMesh_FaceChecker.cxx b/src/BRepMesh/BRepMesh_FaceChecker.cxx
index b78238d69..a0852a441 100644
--- a/src/BRepMesh/BRepMesh_FaceChecker.cxx
+++ b/src/BRepMesh/BRepMesh_FaceChecker.cxx
@@ -268,11 +268,32 @@ void BRepMesh_FaceChecker::perform(const Standard_Integer theWireIndex) const
 
   // TODO: Tolerance is set to twice value of face deflection in order to fit regressions.
   BndBox2dTreeSelector aSelector(2 * myDFace->GetDeflection());
+
+  // The box of this whole wire, built like each segment's box in the selector
+  // (both end points, enlarged by Precision::Confusion()), so it contains every
+  // one of them. When it is out of another wire's tree root, every segment's
+  // query against that tree is rejected at the root and selects nothing: the
+  // wire is skipped without them. Otherwise every segment of this wire was
+  // queried against every later wire -- quadratic in a face's wires (tens of
+  // seconds on a face with thousands of holes). The result is the same.
+  Bnd_Box2d aWireBox1;
+  for (Standard_Integer aSegmentIt = 0; aSegmentIt < aSegments1->Size(); ++aSegmentIt)
+  {
+    aWireBox1.Add(*aSegments1->Value(aSegmentIt).Point1);
+    aWireBox1.Add(*aSegments1->Value(aSegmentIt).Point2);
+  }
+  aWireBox1.Enlarge(Precision::Confusion());
+
   for (Standard_Integer aWireIt = theWireIndex; aWireIt < myDFace->WiresNb(); ++aWireIt)
   {
     const Handle(IMeshData::BndBox2dTree)& aBndBoxTree2 = myWiresBndBoxTree->Value(aWireIt);
     const Handle(Segments)&                aSegments2 = myWiresSegments->Value(aWireIt);
 
+    if (aBndBoxTree2->IsEmpty() || aWireBox1.IsOut(aBndBoxTree2->Root().Bnd()))
+    {
+      continue;
+    }
+
     aSelector.SetSegments(aSegments2);
     for (Standard_Integer aSegmentIt = 0; aSegmentIt < aSegments1->Size(); ++aSegmentIt)
     {
