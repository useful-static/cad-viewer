diff --git a/occt-import-js/src/progress.hpp b/occt-import-js/src/progress.hpp
new file mode 100644
index 0000000..3655be2
--- /dev/null
+++ b/occt-import-js/src/progress.hpp
@@ -0,0 +1,78 @@
+#pragma once
+
+// Progress reporting to JavaScript: Module.onProgress (phase, fraction), when
+// the page passed an onProgress to the module factory. Phases: 1 = reading the
+// file (no fraction available: reported at its start and end), 2 = transferring
+// the model into OpenCascade's document, 3 = meshing.
+
+#include <Message_ProgressIndicator.hxx>
+#include <Message_ProgressScope.hxx>
+
+#include <chrono>
+
+#ifdef EMSCRIPTEN
+#include <emscripten.h>
+#ifdef __EMSCRIPTEN_PTHREADS__
+#include <emscripten/threading.h>
+#endif
+#endif
+
+enum class ProgressPhase : int
+{
+    Read = 1,
+    Transfer = 2,
+    Mesh = 3
+};
+
+inline void ReportProgress (ProgressPhase phase, double fraction)
+{
+#ifdef EMSCRIPTEN
+#ifdef __EMSCRIPTEN_PTHREADS__
+    // only the module's main thread has the page's Module.onProgress; a
+    // worker thread's progress shows when the main thread next reports
+    if (!emscripten_is_main_runtime_thread ()) {
+        return;
+    }
+#endif
+    EM_ASM ({
+        if (typeof Module !== 'undefined' && Module.onProgress) {
+            Module.onProgress ($0, $1);
+        }
+    }, (int) phase, fraction);
+#else
+    (void) phase;
+    (void) fraction;
+#endif
+}
+
+// An OpenCascade progress indicator that forwards its position, at most every
+// half percent or quarter second.
+class JsProgress : public Message_ProgressIndicator
+{
+public:
+    explicit JsProgress (ProgressPhase phase) :
+        Message_ProgressIndicator (),
+        phase (phase),
+        last (-1.0),
+        lastTime (std::chrono::steady_clock::now ())
+    {
+    }
+
+protected:
+    virtual void Show (const Message_ProgressScope& /*scope*/, const Standard_Boolean isForce) override
+    {
+        double position = GetPosition ();
+        auto now = std::chrono::steady_clock::now ();
+        double since = std::chrono::duration<double> (now - lastTime).count ();
+        if (isForce || position - last >= 0.005 || since > 0.25) {
+            last = position;
+            lastTime = now;
+            ReportProgress (phase, position);
+        }
+    }
+
+private:
+    ProgressPhase phase;
+    double last;
+    std::chrono::steady_clock::time_point lastTime;
+};
