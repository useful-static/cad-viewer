 #include <BRepMesh_IncrementalMesh.hxx>
 #include <UnitsMethods.hxx>
 
+#include <BRepBuilderAPI_MakeFace.hxx>
+#include <BRep_Builder.hxx>
+#include <GeomLib_IsPlanarSurface.hxx>
