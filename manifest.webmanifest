{
  "name": "CAD viewer",
  "short_name": "CAD viewer",
  "description": "View STEP, IGES, BREP, mesh, DXF and DWG files in the browser. Files stay on your device.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#1d2127",
  "theme_color": "#1d2127",
  "icons": [{ "src": "favicon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }],
  "file_handlers": [{
    "action": "./",
    "accept": {
      "model/step": [".stp", ".step"],
      "model/iges": [".igs", ".iges"],
      "application/x-brep": [".brep", ".brp"],
      "application/x-cadmesh": [".cadmesh"],
      "model/stl": [".stl"],
      "model/obj": [".obj"],
      "application/x-ply": [".ply"],
      "application/x-off": [".off"],
      "model/3mf": [".3mf"],
      "model/gltf-binary": [".glb"],
      "model/gltf+json": [".gltf"],
      "image/vnd.dxf": [".dxf"],
      "image/vnd.dwg": [".dwg"],
      "application/zip": [".zip"]
    }
  }]
}
